# Browser-safe values (exposed to the browser; RLS must protect database records).
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY
# Legacy support if your existing project only has an anon JWT key:
# VITE_SUPABASE_ANON_KEY=YOUR_LEGACY_ANON_JWT

# Server-only Vercel Function values. Never prefix secrets with VITE_ or commit real values.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SECRET_KEY=sb_secret_YOUR_KEY
# Legacy fallback if your existing project only has a service_role JWT key:
# SUPABASE_SERVICE_ROLE_KEY=YOUR_LEGACY_SERVICE_ROLE_JWT
RESEND_API_KEY=re_your_resend_api_key
ORDER_EMAIL_FROM=Blitz Gaming Orders <orders@your-verified-domain.com>

# Lahza / Bank of Palestine hosted card checkout (server-only; never use VITE_ prefix).
# Obtain a merchant account and test/live secret key from Lahza. Start with a test key.
LAHZA_SECRET_KEY=sk_test_replace_with_your_lahza_test_secret
# Public HTTPS site URL used for payment callbacks. SITE_URL is preferred; VERCEL_URL is a fallback on Vercel.
SITE_URL=https://your-project.vercel.app
